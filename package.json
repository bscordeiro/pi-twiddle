{
  "name": "pi-twiddle",
  "version": "2.2.0",
  "private": false,
  "type": "module",
  "description": "Prompt distillation extension for pi.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "config.ts",
    "footer.ts",
    "intent.ts",
    "models.ts",
    "picker.ts",
    "optimizer.ts",
    "preserve.ts",
    "project.ts",
    "tokenizer.ts",
    "missing-model-warning.ts",
    "history.ts",
    "assets/icon.png",
    "assets/prompt-report.png",
    "assets/settings.png",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
